# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ACLED — myACLED account (acleddata.com/user/register), OAuth login
ACLED_EMAIL=your-acled-account-email
ACLED_PASSWORD=your-acled-account-password

# Random secret string; also set as an env var on Vercel so /api/sync-acled
# can only be triggered by Vercel Cron (or you, using the same value).
CRON_SECRET=change-me
