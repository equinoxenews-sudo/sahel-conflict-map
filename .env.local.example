# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ACLED — myACLED account (acleddata.com/user/register), OAuth login
ACLED_EMAIL=your-acled-account-email
ACLED_PASSWORD=your-acled-account-password

# Random secret string; also set as an env var on Vercel so /api/sync-acled
# can only be triggered by Vercel Cron (or you, using the same value).
CRON_SECRET=change-me

# --- Budget de l'API Anthropic (tous facultatifs, valeurs par défaut ci-dessous) ---
# Suivi dans la table ai_usage (supabase/add-ai-usage.sql). Coûts estimés, la Console fait foi.
# AI_BUDGET_WARN_USD=3          # avertissement
# AI_BUDGET_STOP_USD=5          # suspension des traitements non essentiels (synthèses de zone, points de situation)
# AI_BUDGET_HARD_USD=8          # arrêt de tous les traitements IA (filet de sécurité)
# AI_WEB_SEARCH_MONTHLY_CAP=0   # recherches web par mois (0 = désactivées)
# AI_WEB_SEARCHES_PER_RUN=3     # recherches web maximum par synthèse de zone
# AI_MIN_NEW_ARTICLES=3         # articles en attente à partir desquels une synthèse du jour est générée
# AI_MAX_PENDING_AGE_HOURS=36   # un article en attente depuis plus longtemps déclenche la synthèse malgré tout
