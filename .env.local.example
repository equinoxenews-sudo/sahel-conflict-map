# Modèle des variables d'environnement d'Équinoxe. Copier en .env.local (jamais commité) et remplir.
# Sur Vercel : Project Settings > Environment Variables. Sur GitHub : Settings > Secrets and variables > Actions
# (secrets : SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_SUPABASE_URL, ANTHROPIC_API_KEY, CRON_SECRET ;
#  variables : SYNTHESIS_MODEL, PSIT_MODEL, AI_BUDGET_MONTHLY_USD, AI_WEB_SEARCH_MONTHLY_CAP, AI_WEB_SEARCHES_PER_RUN).

# --- Supabase — Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Accès aux traitements planifiés ---
# Chaîne aléatoire longue. À définir aussi sur Vercel ET dans les secrets GitHub (même valeur) : sans elle,
# toutes les routes /api/sync-*, /api/revalidate et /api/cron/dispatch refusent tout accès.
CRON_SECRET=change-me

# --- API Anthropic (synthèses, points de situation) ---
ANTHROPIC_API_KEY=your-anthropic-key
# Modèles (facultatifs, valeurs par défaut dans le code) :
# BRIEFS_MODEL=                 # synthèses du jour (Haiku 4.5 par défaut)
# SYNTHESIS_MODEL=              # synthèses de zone
# PSIT_MODEL=                   # points de situation (Opus par défaut)
# ANALYST_V2_ZONES=             # zones au fonctionnement « analyste » (les cinq par défaut)

# --- Budget de l'API Anthropic (facultatifs) ---
# Suivi dans la table ai_usage (supabase/add-ai-usage.sql). Coûts estimés, la Console fait foi.
# Le mode du mois (normal, tendu, critique) se calcule d'après le rythme de la dépense (lib/aiBudget.ts).
# AI_BUDGET_MONTHLY_USD=46      # budget mensuel en dollars
# AI_WEB_SEARCH_MONTHLY_CAP=0   # recherches web par mois (0 = désactivées)
# AI_WEB_SEARCHES_PER_RUN=3     # recherches web maximum par synthèse de zone
# AI_MIN_NEW_ARTICLES=3         # articles en attente à partir desquels une synthèse du jour est générée
# AI_MAX_PENDING_AGE_HOURS=36   # un article en attente depuis plus longtemps déclenche la synthèse malgré tout
# AI_PRICE_INPUT_PER_MTOK=      # tarifs d'estimation si le modèle change (dollars par million de jetons)
# AI_PRICE_OUTPUT_PER_MTOK=
# AI_PRICE_WEB_SEARCH_PER_1000=

# --- Lancement des workflows GitHub depuis les crons Vercel ---
# Jeton GitHub à droits minimaux (ce dépôt, « Actions : lecture et écriture »). À renouveler avant son expiration :
# sans lui, les planifications de secours de GitHub prennent le relais, avec des retards de plusieurs heures.
GITHUB_DISPATCH_TOKEN=your-github-token
# GITHUB_REPOSITORY_SLUG=equinoxenews-sudo/sahel-conflict-map

# --- Compte du site (Investigation, Mon espace, brouillons de points de situation) ---
ADMIN_PASSWORD=choose-a-long-password
# ADMIN_USER=                   # identifiant (par défaut : celui défini dans lib/adminAuth.ts)

# --- Telegram (alertes à Nicolas, webhook des boutons) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=

# --- Suivi navires et avions (dormant depuis le 18/10/2026) ---
# AISSTREAM_API_KEY=
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
